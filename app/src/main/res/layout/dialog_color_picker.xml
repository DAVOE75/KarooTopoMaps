<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvColorPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_picker_title"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Continuous Rainbow Hue Spectrum Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_spectrum_title"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <com.davoe.karootopomaps.ColorSpectrumBar
        android:id="@+id/spectrumBar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginBottom="10dp" />

    <!-- Intensity & Tone Gradient Bar (Light to 100% Pure) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_intensity_title"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <com.davoe.karootopomaps.ColorIntensityBar
        android:id="@+id/intensityBar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginBottom="12dp" />

    <!-- Palette of High-Visibility Outdoor Cycling Colors -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_palette_title"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <GridLayout
            android:id="@+id/gridPalette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="6"
            android:rowCount="5" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_selected_label"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreviewWrapper"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp"
            android:layout_marginEnd="10dp">

            <View
                android:id="@+id/viewSelectedColorPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFD700" />

        </com.google.android.material.card.MaterialCardView>

        <EditText
            android:id="@+id/etHexCode"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#2E2E2E"
            android:hint="#RRGGBB"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textCapCharacters"
            android:maxLength="7"
            android:typeface="monospace"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
