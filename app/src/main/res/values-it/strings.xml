    <string name="theme_ign_name">IGN</string>
    <string name="theme_ign_desc">Tavolozza ufficiale IGN 1:25.000: curve di livello, rilievo, tinte ipsometriche e lotti dettagliati.</string>

    <string name="theme_vintage_name">Esploratore Vintage</string>
    <string name="theme_vintage_desc">Incisione ottocentesca monocromatica color seppia, ideale per pedalate gravel rilassanti.</string>

    <string name="theme_gravel_name">Terra e Ghiaia</string>
    <string name="theme_gravel_desc">Stile alpino organico in argilla e sabbia. Massima definizione per sentieri e piste forestali.</string>

    <string name="theme_dem_name">Tecnologico / DEM</string>
    <string name="theme_dem_desc">Mappa termica ipsometrica continua. Rilievo nitido per affrontare salite e passi montani.</string>

    <string name="theme_trail_name">Territorio Trail</string>
    <string name="theme_trail_desc">Ottimizzato per MTB: foreste dense e classificazione tecnica dei sentieri con codice colore.</string>

    <string name="theme_granite_name">Granito Altiplano</string>
    <string name="theme_granite_desc">Estetica minerale pulita in ardesia e toni freddi. Geometria scandinava ad alto contrasto.</string>

    <string name="theme_dark_name">Modalità Notturna Tattica</string>
    <string name="theme_dark_desc">Sfondo scuro opaco antiriflesso per evitare l\'affaticamento visivo durante le uscite notturne.</string>

    <string name="theme_elevate_name">Elevate MTB</string>
    <string name="theme_elevate_desc">Stile alpino classico con percorsi ben visibili e segnaletica escursionistica completa.</string>

    <string name="theme_alt_name">ALT-MTB Speciale</string>
    <string name="theme_alt_desc">Variante ad altissimo contrasto ottico per visibilità estrema sotto la luce solare diretta.</string>

