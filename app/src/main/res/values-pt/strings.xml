    <string name="theme_ign_name">IGN</string>
    <string name="theme_ign_desc">Paleta oficial IGN 1:25.000: curvas de nível, relevo nítido, cores hipsométricas e parcelamento claro.</string>

    <string name="theme_vintage_name">Explorador Vintage</string>
